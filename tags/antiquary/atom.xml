&lt;pre data-lang=&quot;chatlink&quot; class=&quot;language-chatlink z-code&quot;&gt;&lt;code class=&quot;language-chatlink&quot; data-lang=&quot;chatlink&quot;&gt;&lt;span class=&quot;z-source z-chatlink&quot;&gt;&lt;span class=&quot;z-punctuation z-definition z-string z-begin&quot;&gt;[&amp;amp;&lt;&#x2F;span&gt;DQUsNxwbTSskDwAALwEAAA0BAAALAQAAfB0AAAAAAAAAAAAAAAAAAAAAAAADVgAvAAkBAA==&lt;span class=&quot;z-punctuation z-definition z-string z-end&quot;&gt;]&lt;&#x2F;span&gt;
&lt;&#x2F;span&gt;&lt;&#x2F;code&gt;&lt;&#x2F;pre&gt;
&lt;hr &#x2F;&gt;
&lt;div data-armory-embed=&#x27;skills&#x27; data-armory-ids=&#x27;21778,13037,13028,13026,77255&#x27;&gt;&lt;&#x2F;div&gt;&lt;div data-armory-embed=&#x27;specializations&#x27; data-armory-ids=&#x27;44,28,77&#x27; data-armory-44-traits=&#x27;1163,1277,1706&#x27; data-armory-28-traits=&#x27;1164,1292,1291&#x27; data-armory-77-traits=&#x27;2346,2431,2393&#x27;&gt;&lt;&#x2F;div&gt;
&lt;h4 id=&quot;rotation&quot;&gt;Rotation&lt;&#x2F;h4&gt;
&lt;p&gt;Precast - &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;56898&quot;&gt;&lt;&#x2F;span&gt; Thousand Needles&lt;&#x2F;p&gt;
&lt;blockquote&gt;
&lt;ol&gt;
&lt;li&gt;Use &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;77397&quot;&gt;&lt;&#x2F;span&gt; Skritt Swipe and &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;77255&quot;&gt;&lt;&#x2F;span&gt; Skritt Scuffle for &lt;strong&gt;Artifacts&lt;&#x2F;strong&gt; (Stolen Skill)&lt;&#x2F;li&gt;
&lt;li&gt;Use your &lt;strong&gt;Artifacts&lt;&#x2F;strong&gt; for alacrity&lt;&#x2F;li&gt;
&lt;li&gt;Try to catch different stolen skills, you may prioritise skills that provide DPS&#x2F;Initiative:
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;77192&quot;&gt;&lt;&#x2F;span&gt; Summon Kryptis Turret&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;76633&quot;&gt;&lt;&#x2F;span&gt; Forged Surfer Dash&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;76816&quot;&gt;&lt;&#x2F;span&gt; Chak Shield&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;76674&quot;&gt;&lt;&#x2F;span&gt; Holo-Dancer Decoy (Use with &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;13037&quot;&gt;&lt;&#x2F;span&gt; Spider Venom)&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
&lt;&#x2F;li&gt;
&lt;li&gt;If you catch &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;76582&quot;&gt;&lt;&#x2F;span&gt; Metal Legion Guitar, use &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;63314&quot;&gt;&lt;&#x2F;span&gt; Shadowsquall (Sc 1) to use your Stealth Attacks x 3.&lt;&#x2F;li&gt;
&lt;li&gt;Use all your initiative on &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;63254&quot;&gt;&lt;&#x2F;span&gt; Twilight Combo (Press &amp;amp; Hold Sc 3)&lt;&#x2F;li&gt;
&lt;&#x2F;ol&gt;
&lt;&#x2F;blockquote&gt;
&lt;h4 id=&quot;utilties&quot;&gt;Utilties&lt;&#x2F;h4&gt;
&lt;blockquote&gt;
&lt;ol&gt;
&lt;li&gt;Utilities to cast on cooldown
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;13037&quot;&gt;&lt;&#x2F;span&gt; Spider Venom&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;13028&quot;&gt;&lt;&#x2F;span&gt; Caltrops&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;56898&quot;&gt;&lt;&#x2F;span&gt; Thousand Needles&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;13093&quot;&gt;&lt;&#x2F;span&gt; Devourer Venom (viable on mobile fights)&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
