&lt;blockquote&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;13012&quot;&gt;&lt;&#x2F;span&gt; Head Shot (Pistol 4)&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;77255&quot;&gt;&lt;&#x2F;span&gt; Skritt Scuffle (Elite)&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;76582&quot;&gt;&lt;&#x2F;span&gt; Metal Legion Guitar (Artifact)&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;76909&quot;&gt;&lt;&#x2F;span&gt; Unstable Skritt Bomb (Artifact)&lt;&#x2F;li&gt;
