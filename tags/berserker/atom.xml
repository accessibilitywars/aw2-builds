&lt;&#x2F;ul&gt;
&lt;&#x2F;blockquote&gt;
&lt;h4 id=&quot;food-enhancement&quot;&gt;Food, Enhancement&lt;&#x2F;h4&gt;
&lt;ul&gt;
&lt;li&gt;Food: &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;items&quot; data-armory-ids=&quot;91878&quot;&gt;&lt;&#x2F;span&gt; Cilantro and Cured Meat Flatbread&lt;&#x2F;li&gt;
&lt;li&gt;Food: &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;items&quot; data-armory-ids=&quot;95241&quot;&gt;&lt;&#x2F;span&gt; Feast of Delectable Birthday Cake (Budget)&lt;&#x2F;li&gt;
&lt;li&gt;Enhancement: &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;items&quot; data-armory-ids=&quot;48917&quot;&gt;&lt;&#x2F;span&gt; Toxic Tuning Crystal&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
&lt;h4 id=&quot;infusions&quot;&gt;Infusions&lt;&#x2F;h4&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;items&quot; data-armory-ids=&quot;43253&quot;&gt;&lt;&#x2F;span&gt; Malign WvW Infusion (optional)&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
&lt;h2 id=&quot;build&quot;&gt;Build&lt;&#x2F;h2&gt;
&lt;hr &#x2F;&gt;
&lt;p&gt;&lt;a rel=&quot;noopener&quot; target=&quot;_blank&quot; href=&quot;https:&#x2F;&#x2F;gw2skills.net&#x2F;editor&#x2F;?PKwAwyNlZwsYUsJWJO+K9NVA-DSRYmRH1kPbI5COl4UA5KBSXI0hIQhHDCQ4agXTKOrgVA-e&quot;&gt;qDPS GW2Skills Link&lt;&#x2F;a&gt;&lt;br&#x2F;&gt;&lt;&#x2F;p&gt;
&lt;hr &#x2F;&gt;
&lt;pre data-lang=&quot;chatlink&quot; class=&quot;language-chatlink z-code&quot;&gt;&lt;code class=&quot;language-chatlink&quot; data-lang=&quot;chatlink&quot;&gt;&lt;span class=&quot;z-source z-chatlink&quot;&gt;&lt;span class=&quot;z-punctuation z-definition z-string z-begin&quot;&gt;[&amp;amp;&lt;&#x2F;span&gt;DQIEHyQ9EiryEqcA3BKtANcSrwCvAAAAwhLuAAAAAAAAAAAAAAAAAAAAAAACWgAjAAA=&lt;span class=&quot;z-punctuation z-definition z-string z-end&quot;&gt;]&lt;&#x2F;span&gt;
&lt;&#x2F;span&gt;&lt;&#x2F;code&gt;&lt;&#x2F;pre&gt;
&lt;hr &#x2F;&gt;
&lt;div data-armory-embed=&#x27;skills&#x27; data-armory-ids=&#x27;30189,30074,30258,14410,30343&#x27;&gt;&lt;&#x2F;div&gt;&lt;div data-armory-embed=&#x27;specializations&#x27; data-armory-ids=&#x27;4,36,18&#x27; data-armory-4-traits=&#x27;1444,1449,1437&#x27; data-armory-36-traits=&#x27;1455,1333,1707&#x27; data-armory-18-traits=&#x27;2039,2042,2038&#x27;&gt;&lt;&#x2F;div&gt;
&lt;h2 id=&quot;rotation&quot;&gt;Rotation&lt;&#x2F;h2&gt;
&lt;hr &#x2F;&gt;
&lt;h4 id=&quot;opener-optional&quot;&gt;Opener (optional)&lt;&#x2F;h4&gt;
&lt;ol&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30343&quot;&gt;&lt;&#x2F;span&gt; Head Butt → &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30435&quot;&gt;&lt;&#x2F;span&gt; Berserk&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;29923&quot;&gt;&lt;&#x2F;span&gt; Scorched Earth (🏹Burst)(x2 ↔ &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30189&quot;&gt;&lt;&#x2F;span&gt; Blood Reckoning)&lt;&#x2F;li&gt;
&lt;li&gt;🔁Weapon Swap -&amp;gt; &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;14366&quot;&gt;&lt;&#x2F;span&gt; Savage Leap (⚔2)&lt;&#x2F;li&gt;
&lt;&#x2F;ol&gt;
&lt;blockquote&gt;
&lt;ul&gt;
&lt;li&gt;&lt;small&gt;Your opener gives a significant amount of &lt;strong&gt;Quickness&lt;&#x2F;strong&gt;.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;li&gt;&lt;small&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30189&quot;&gt;&lt;&#x2F;span&gt; Blood Reckoning allows you to double cast &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;29923&quot;&gt;&lt;&#x2F;span&gt; Scorched Earth (🏹 Burst).&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;li&gt;&lt;small&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;14366&quot;&gt;&lt;&#x2F;span&gt; Savage Leap provides &lt;strong&gt;Fire Aura&lt;&#x2F;strong&gt; for extra DPS.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;li&gt;&lt;small&gt;Performing&#x2F;Repeating the opener will result in small DPS increases.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
&lt;&#x2F;blockquote&gt;
&lt;h4 id=&quot;dps-rotation&quot;&gt;DPS Rotation&lt;&#x2F;h4&gt;
&lt;p&gt;Use the following off-cooldown:&lt;&#x2F;p&gt;
&lt;ol&gt;
&lt;li&gt;Utilities&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30682&quot;&gt;&lt;&#x2F;span&gt; Flaming Flurry (⚔Burst)(x2 ↔ &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30189&quot;&gt;&lt;&#x2F;span&gt; Blood Reckoning)&lt;&#x2F;li&gt;
&lt;li&gt;Sword Skills
&lt;ul&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;14498&quot;&gt;&lt;&#x2F;span&gt; Impale (⚔4)&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;80247&quot;&gt;&lt;&#x2F;span&gt; Rend (⚔3)&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;80203&quot;&gt;&lt;&#x2F;span&gt; Bloodthirster (⚔Burst)&lt;&#x2F;li&gt;
&lt;&#x2F;ol&gt;
&lt;blockquote&gt;
&lt;ul&gt;
&lt;li&gt;&lt;small&gt;Use &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30682&quot;&gt;&lt;&#x2F;span&gt; Flaming Flurry → &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30189&quot;&gt;&lt;&#x2F;span&gt; Blood Reckoning together to double cast your Primal Burst.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;li&gt;&lt;small&gt;Use &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30074&quot;&gt;&lt;&#x2F;span&gt; Shattering Blow → &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30343&quot;&gt;&lt;&#x2F;span&gt; Head Butt together to mitigate the stun effect.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;li&gt;&lt;small&gt;Using &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30343&quot;&gt;&lt;&#x2F;span&gt; Head Butt helps provide a buffer to upkeep &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30435&quot;&gt;&lt;&#x2F;span&gt; Berserk status.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;li&gt;&lt;small&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30258&quot;&gt;&lt;&#x2F;span&gt; Outrage has no cast time and can be simultaneously casted together with other skills. DO NOT delay this skill.&lt;&#x2F;small&gt;&lt;&#x2F;li&gt;
&lt;&#x2F;ul&gt;
&lt;&#x2F;blockquote&gt;
&lt;h4 id=&quot;optimisations-and-cc&quot;&gt;Optimisations and CC.&lt;&#x2F;h4&gt;
&lt;ol&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;14505&quot;&gt;&lt;&#x2F;span&gt; Smoldering Arrow (🏹 4) provides a small CC.&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;30343&quot;&gt;&lt;&#x2F;span&gt; Head Butt (Elite) is a strong CC skill.&lt;&#x2F;li&gt;
&lt;li&gt;Use Bow Skills to upkeep adrenaline and DPS when locked out of range.&lt;&#x2F;li&gt;
&lt;li&gt;&lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;14410&quot;&gt;&lt;&#x2F;span&gt; Signet of Fury (when you need &lt;strong&gt;Adrenaline&lt;&#x2F;strong&gt; at range)&lt;&#x2F;li&gt;
&lt;li&gt;A well timed &lt;span class=&quot;armory-inline&quot; data-armory-embed=&quot;skills&quot; data-armory-ids=&quot;14400&quot;&gt;&lt;&#x2F;span&gt; Riposte (⚔5) increases damage significantly on actual fights.&lt;&#x2F;li&gt;
